; Engine configuration file.
; Ishtaria client – Godot 4 project.

config_version=5

[application]

config/name="Ishtaria"
config/description="Client for the Ishtaria federated virtual planet."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://assets/branding/icon.png"
boot_splash/bg_color=Color(0.0627451, 0.0784314, 0.0588235, 1)
boot_splash/image="res://assets/branding/splash.png"
boot_splash/fullsize=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

3d/physics_engine="Jolt Physics"

[internationalization]

locale/translations=PackedStringArray("res://locales/client.en.translation", "res://locales/client.cs.translation")
locale/fallback="en"

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
