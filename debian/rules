#!/usr/bin/make -f
# Needs Godot 4.5 and its Linux export templates from the godot4 and
# godot4-export-templates packages (nothing is downloaded during the build).
GODOT ?= /usr/bin/godot4
export XDG_DATA_HOME = $(CURDIR)/build/xdg

%:
	dh $@

override_dh_auto_build:
	mkdir -p build $(XDG_DATA_HOME)/godot/export_templates
	ln -sfn /usr/share/godot4/export_templates/4.5.stable $(XDG_DATA_HOME)/godot/export_templates/4.5.stable
	$(GODOT) --headless --import
	$(GODOT) --headless --export-release Linux build/ishtaria-client.x86_64

override_dh_auto_install:
	install -D -m 0755 build/ishtaria-client.x86_64 debian/ishtaria-client/usr/lib/ishtaria-client/ishtaria-client
	install -D -m 0755 debian/ishtaria-client.sh debian/ishtaria-client/usr/bin/ishtaria-client
	install -D -m 0644 debian/ishtaria-client.desktop debian/ishtaria-client/usr/share/applications/ishtaria-client.desktop
	install -D -m 0644 debian/ishtaria-client.metainfo.xml debian/ishtaria-client/usr/share/metainfo/com.vitexsoftware.ishtaria.client.metainfo.xml
	for s in 48 128 256; do \
		install -D -m 0644 assets/branding/ishtaria-client-$$s.png debian/ishtaria-client/usr/share/icons/hicolor/$${s}x$${s}/apps/ishtaria-client.png; \
	done

# Godot binaries are already stripped and may not survive objcopy.
override_dh_strip:
override_dh_dwz:

override_dh_auto_clean:
	rm -rf build .godot
